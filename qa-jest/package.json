{
  "name": "qa-forge-jest",
  "version": "1.1.2",
  "description": "QAnalyzer Jest reporter — ingest or file modes via qa-forge-commons",
  "keywords": [
    "qanalyzer",
    "jest",
    "jest-reporter",
    "testing",
    "jira"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jest": {
      "types": "./dist/jest.d.ts",
      "default": "./dist/jest.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && npx tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test dist/__tests__/**/*.test.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "qa-forge-commons": "^1.0.0"
  },
  "peerDependencies": {
    "jest": ">=29.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "license": "Apache-2.0"
}
