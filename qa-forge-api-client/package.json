{
  "name": "@qanalyzer/forge-api-client",
  "version": "1.2.1",
  "description": "CLI client for QAnalyzer Forge ingest API (Jest/Vitest JSON upload)",
  "keywords": [
    "qanalyzer",
    "cli",
    "forge",
    "testing",
    "jira"
  ],
  "bin": {
    "forge-api-client": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "!dist/__tests__",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && npx tsc --project tsconfig.build.json && chmod +x dist/cli.js",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../examples/single/vitest/vitest.config.ts --project qa-forge-api-client",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@qanalyzer/forge-commons": "^1.1.1"
  },
  "license": "Apache-2.0"
}
