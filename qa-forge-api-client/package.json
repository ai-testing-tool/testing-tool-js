{
  "name": "qa-forge-api-client",
  "version": "1.1.2",
  "description": "CLI client for QAnalyzer Forge ingest API (Jest/Vitest JSON upload)",
  "keywords": [
    "qanalyzer",
    "cli",
    "forge",
    "testing",
    "jira"
  ],
  "bin": {
    "qa-forge-api-client": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "!dist/__tests__",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
