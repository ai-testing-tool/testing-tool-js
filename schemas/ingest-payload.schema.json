{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qanalyzer.local/schemas/ingest-payload.schema.json",
  "title": "QAnalyzer ingest payload (FR41)",
  "type": "object",
  "required": ["projectKey", "report"],
  "additionalProperties": true,
  "properties": {
    "projectKey": { "type": "string", "minLength": 1 },
    "launchName": { "type": "string" },
    "format": {
      "type": "string",
      "enum": ["jest-json", "vitest-json", "normalized", "junit-xml"],
      "description": "Primary: jest-json / vitest-json. Optional secondary: junit-xml (report is XML string)."
    },
    "ciPlatform": { "type": "string" },
    "buildUrl": { "type": "string" },
    "gitCommitSha": { "type": "string" },
    "gitBranch": { "type": "string" },
    "gitAuthorName": { "type": "string" },
    "gitAuthorEmail": { "type": "string" },
    "ciTriggeredBy": { "type": "string" },
    "gitCommittedAt": { "type": "string" },
    "gitCommitMessageSubject": { "type": "string" },
    "gitCommitMessageBody": { "type": "string" },
    "report": {
      "description": "Jest/Vitest JSON object (primary), or JUnit XML string when format=junit-xml",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["testResults"],
          "properties": {
            "numTotalTests": { "type": "number" },
            "numPassedTests": { "type": "number" },
            "numFailedTests": { "type": "number" },
            "numPendingTests": { "type": "number" },
            "numTodoTests": { "type": "number" },
            "startTime": { "type": "number" },
            "success": { "type": "boolean" },
            "testResults": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "status": { "type": "string" },
                  "assertionResults": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": { "type": "string" },
                        "fullName": { "type": "string" },
                        "status": { "type": "string" },
                        "meta": {
                          "type": "object",
                          "description": "Optional extensions; meta.qa carries reporter-rich metadata (FR41). Prefer meta.qa.issueKeys for FR43 over embedding keys in titles.",
                          "properties": {
                            "qa": {
                              "type": "object",
                              "description": "Serialized QA metadata: suite, issueKeys, fields, steps, comments, attachments",
                              "properties": {
                                "issueKeys": {
                                  "type": "array",
                                  "items": { "type": "string" },
                                  "description": "Explicit Jira issue keys (FR43). Roles classified via TMS type map. Title keys remain a fallback."
                                }
                              },
                              "additionalProperties": true
                            }
                          },
                          "additionalProperties": true
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                },
                "additionalProperties": true
              }
            }
          }
        }
      ]
    },
    "tests": {
      "type": "array",
      "description": "Optional normalized shape when format=normalized"
    }
  }
}
