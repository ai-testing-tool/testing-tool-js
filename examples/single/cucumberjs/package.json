{
  "name": "ai-testing-tool-cucumberjs-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "AiTestingTool CucumberJS pilot — JSONPlaceholder BDD + @ai-testing-tool/forge-cucumberjs formatter",
  "scripts": {
    "test": "AI_TESTING_TOOL_MODE=${AI_TESTING_TOOL_MODE:-off} cucumber-js",
    "test:file": "AI_TESTING_TOOL_MODE=file AI_TESTING_TOOL_PROJECT_KEY=AUTH cucumber-js",
    "upload": "npx @ai-testing-tool/forge-api-client --project AUTH --launch \"cucumberjs pilot\" --report ai-testing-tool-results.json"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@ai-testing-tool/forge-cucumberjs": "file:../../../qa-cucumberjs",
    "@ai-testing-tool/forge-commons": "file:../../../qa-javascript-commons"
  }
}
