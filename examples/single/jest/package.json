{
  "name": "ai-testing-tool-jest-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "AiTestingTool Jest pilot — JSONPlaceholder API tests + @ai-testing-tool/forge-jest reporter",
  "scripts": {
    "test": "AI_TESTING_TOOL_MODE=${AI_TESTING_TOOL_MODE:-off} jest --runInBand",
    "test:file": "AI_TESTING_TOOL_MODE=file AI_TESTING_TOOL_PROJECT_KEY=AUTH jest --runInBand",
    "test:json": "jest --runInBand --json --outputFile=ai-testing-tool-results.json",
    "upload": "npx @ai-testing-tool/forge-api-client --project AUTH --launch \"jest pilot\" --report ai-testing-tool-results.json"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@ai-testing-tool/forge-commons": "file:../../../qa-javascript-commons",
    "@ai-testing-tool/forge-jest": "file:../../../qa-jest",
    "jest": "^29.7.0"
  }
}
