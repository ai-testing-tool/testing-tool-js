{
  "name": "ai-testing-tool-wdio-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "AiTestingTool WebdriverIO pilot — saucedemo e-commerce E2E + @ai-testing-tool/forge-wdio reporter",
  "scripts": {
    "test": "AI_TESTING_TOOL_MODE=${AI_TESTING_TOOL_MODE:-off} npx wdio run ./wdio.conf.js",
    "test:cucumber": "AI_TESTING_TOOL_MODE=${AI_TESTING_TOOL_MODE:-off} npx wdio run ./wdio.cucumber.conf.js",
    "test:file": "AI_TESTING_TOOL_MODE=file AI_TESTING_TOOL_PROJECT_KEY=AUTH npx wdio run ./wdio.conf.js",
    "upload": "npx @ai-testing-tool/forge-api-client --project AUTH --launch \"wdio pilot\" --report ai-testing-tool-results.json"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@wdio/cli": "^9.27.0",
    "@wdio/cucumber-framework": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.29.1",
    "@ai-testing-tool/forge-commons": "file:../../../qa-javascript-commons",
    "@ai-testing-tool/forge-wdio": "file:../../../qa-wdio"
  }
}
