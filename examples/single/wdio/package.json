{
  "name": "qanalyzer-wdio-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "QAnalyzer WebdriverIO pilot — saucedemo e-commerce E2E + qa-forge-wdio reporter",
  "scripts": {
    "test": "QANALYZER_MODE=${QANALYZER_MODE:-off} npx wdio run ./wdio.conf.js",
    "test:cucumber": "QANALYZER_MODE=${QANALYZER_MODE:-off} npx wdio run ./wdio.cucumber.conf.js",
    "test:file": "QANALYZER_MODE=file QANALYZER_PROJECT_KEY=AUTH npx wdio run ./wdio.conf.js",
    "upload": "npx qa-forge-api-client --project AUTH --launch \"wdio pilot\" --report qanalyzer-results.json"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@wdio/cli": "^9.27.0",
    "@wdio/cucumber-framework": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.29.1",
    "qa-forge-commons": "file:../../../qa-javascript-commons",
    "qa-forge-wdio": "file:../../../qa-wdio"
  }
}
