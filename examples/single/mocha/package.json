{
  "name": "qanalyzer-mocha-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "QAnalyzer Mocha pilot — JSONPlaceholder API tests + qa-mocha reporter",
  "scripts": {
    "test": "QANALYZER_MODE=${QANALYZER_MODE:-off} mocha",
    "test:file": "QANALYZER_MODE=file QANALYZER_PROJECT_KEY=AUTH mocha",
    "upload": "npx qa-forge-api-client --project AUTH --launch \"mocha pilot\" --report qanalyzer-results.json"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "mocha": "^11.7.1",
    "qa-javascript-commons": "file:../../../qa-javascript-commons",
    "qa-mocha": "file:../../../qa-mocha"
  }
}
