{
  "name": "@qanalyzer/forge-playwright",
  "version": "1.2.1",
  "description": "QAnalyzer Playwright reporter — ingest or file modes via @qanalyzer/forge-commons",
  "keywords": [
    "qanalyzer",
    "playwright",
    "reporter",
    "testing",
    "jira"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "default": "./dist/helpers.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && npx tsc --project tsconfig.build.json && cp -R src/__fixtures__ dist/__fixtures__",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../examples/single/vitest/vitest.config.ts --project qa-playwright",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@qanalyzer/forge-commons": "^1.1.1"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1"
  },
  "license": "Apache-2.0"
}
