{
  "name": "@qanalyzer/forge-mocha",
  "version": "1.2.0",
  "description": "QAnalyzer Mocha reporter — ingest or file modes via @qanalyzer/forge-commons",
  "keywords": [
    "qanalyzer",
    "mocha",
    "reporter",
    "testing",
    "jira"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mocha": {
      "types": "./dist/mocha.d.ts",
      "default": "./dist/mocha.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && npx tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test dist/__tests__/**/*.test.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@qanalyzer/forge-commons": "^1.1.1"
  },
  "peerDependencies": {
    "mocha": ">=10.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "mocha": "^11.3.0"
  },
  "license": "Apache-2.0"
}
